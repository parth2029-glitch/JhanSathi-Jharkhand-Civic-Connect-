# All of these are optional. With none set, the API boots an in-process MongoDB,
# seeds demo data and stores photos on local disk — no accounts required.

PORT=4000

# Real MongoDB (Atlas or local). Omit to use the throwaway in-memory server.
# MONGO_URI=mongodb://127.0.0.1:27017/civic

# Sign JWTs with a real secret before deploying anywhere public.
# JWT_SECRET=change-me

# Cloudinary. Omit and photos are written to server/uploads/ and served from there.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Tuning knobs the government can change without touching code.
# DUPLICATE_RADIUS_M=50
# SENSITIVE_WARDS=Ward 1,Ward 4
# HOTSPOT_MIN=3
